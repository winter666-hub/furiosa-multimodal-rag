# Furiosa hosted API. Keep the real API key only in .env.
FURIOSA_API_KEY=EMPTY
FURIOSA_REQUEST_TIMEOUT=10

FURIOSA_LLM_BASE_URL=https://endpoint.access.furiosa.dev/v1
FURIOSA_LLM_MODEL=furiosa-ai/Qwen3-32B-FP8

# May point to a local SSH forward (for example http://localhost:8000/v1) or hosted API.
FURIOSA_VISION_BASE_URL=https://endpoint.access.furiosa.dev/v1
FURIOSA_VISION_MODEL=furiosa-ai/Qwen3-VL-32B-Instruct
FURIOSA_VISION_MAX_TOKENS=256

FURIOSA_EMBEDDING_BASE_URL=https://endpoint.access.furiosa.dev/v1
FURIOSA_EMBEDDING_MODEL=furiosa-ai/Qwen3-Embedding-8B

FURIOSA_RERANKER_BASE_URL=https://endpoint.access.furiosa.dev/v1
FURIOSA_RERANKER_MODEL=furiosa-ai/Qwen3-Reranker-8B

# Single-instance public demo abuse controls (process-local).
# Set the same independent random value in the Cloudflare Worker and Render.
# This is a proxy trust token, not the Furiosa API key.
PAPER_RAG_PROXY_SECRET=replace-with-a-long-random-proxy-secret
UPLOAD_RATE_LIMIT_REQUESTS=3
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=600
ASK_RATE_LIMIT_REQUESTS=20
ASK_RATE_LIMIT_WINDOW_SECONDS=600
MAX_CONCURRENT_UPLOADS=1
MAX_CONCURRENT_ASKS=3
MAX_PDF_UPLOAD_MB=25
MAX_DOCUMENTS=20
DOCUMENT_TTL_HOURS=6
MAX_DOCUMENT_STORAGE_MB=500
DOCUMENT_STORAGE_ROOT=/tmp/furiosa-rag/documents
